{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["test", "scripts/compare-models.ts", "src/handler.ts", "src/claude.ts", "src/codes.ts", "src/config.ts", "src/image.ts", "src/ledgerCore.ts", "vitest.config.ts"]
}
